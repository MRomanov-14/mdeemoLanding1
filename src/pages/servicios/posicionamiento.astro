                                <div class="w-2.5 h-2.5 lg:w-3 lg:h-3 rounded-full bg-[#ffbd2e]"></div>
                                <div class="w-2.5 h-2.5 lg:w-3 lg:h-3 rounded-full bg-[#27c93f]"></div>
