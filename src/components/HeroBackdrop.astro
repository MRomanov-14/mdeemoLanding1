---
interface Props {
    /**
     * Tema en que arranca la página (el `forcedTheme` del Layout, o "dark" si
     * no lo fija). Determina qué variante va como <img> — descargable con
     * prioridad alta, es el LCP — y cuál queda como background-image, que el
     * navegador solo pide si el usuario cambia de tema. Importa: un <img> con
     * display:none se descarga igual, así que servir la variante equivocada
     * como <img> cuesta cientos de KB que nunca se ven.
     */
    base?: "light" | "dark";
    /**
     * Dónde se concentra la zona limpia del scrim. Usa "top" cuando el
     * contenido del hero arranca arriba en vez de ir centrado.
     */
    align?: "center" | "top";
}

const { base = "light", align = "center" } = Astro.props;

const art = {
    light: {
        wide: "/images/hero-skyline.webp",
        portrait: "/images/hero-skyline-mobile.webp",
        fallback: "/images/hero-skyline.jpg",
    },
    dark: {
        wide: "/images/hero-skyline-dark.webp",
        portrait: "/images/hero-skyline-dark-mobile.webp",
        fallback: "/images/hero-skyline-dark.jpg",
    },
};

const alt = base === "light" ? "dark" : "light";
const shown = art[base];
---

{/* Contrapicada de rascacielos: escala y altura. */}
<picture class:list={["hero-photo-layer", `hero-photo-pic--${base}`]}>
    <source type="image/webp" media="(orientation: portrait)" srcset={shown.portrait} />
    <source type="image/webp" srcset={shown.wide} />
    <img src={shown.fallback} alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
</picture>

{/* Variante del tema contrario, como background-image sobre un elemento
    oculto: no se descarga salvo que se active ese tema. */}
<div
    class:list={["hero-photo-layer", "hero-photo-bg", `hero-photo-bg--${alt}`]}
    aria-hidden="true">
</div>

{/* Scrim: sostiene el contraste del texto sobre los edificios y funde el borde
    inferior con la sección siguiente. Cubre light y dark. */}
<div class:list={["hero-scrim", align === "top" && "hero-scrim--top"]} aria-hidden="true"></div>

<style is:global>
    .hero-photo-layer {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
    }

    .hero-photo-layer img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
    }

    /* La capa alterna arranca OCULTA y solo se muestra si su tema está activo.
       El default importa: las páginas que no fijan `forcedTheme` se sirven sin
       atributo data-theme (lo pone el script del final del body), así que en el
       primer paint no casa ninguna regla [data-theme=...]. Si la capa dependiera
       solo de ellas, el navegador la vería visible y descargaría una imagen de
       cientos de KB que nunca se muestra. */
    .hero-photo-bg {
        display: none;
        background-position: center center;
        background-size: cover;
        background-repeat: no-repeat;
    }

    [data-theme="light"] .hero-photo-bg--light,
    [data-theme="dark"] .hero-photo-bg--dark {
        display: block;
    }

    /* El <picture> lleva el arte del tema base, así que solo se oculta cuando
       el usuario activa el tema contrario. */
    [data-theme="light"] .hero-photo-pic--dark,
    [data-theme="dark"] .hero-photo-pic--light {
        display: none;
    }

    .hero-photo-bg--light {
        background-image: url("/images/hero-skyline.jpg");
        background-image: image-set(url("/images/hero-skyline.webp") type("image/webp"),
                url("/images/hero-skyline.jpg") type("image/jpeg"));
    }

    .hero-photo-bg--dark {
        background-image: url("/images/hero-skyline-dark.jpg");
        background-image: image-set(url("/images/hero-skyline-dark.webp") type("image/webp"),
                url("/images/hero-skyline-dark.jpg") type("image/jpeg"));
    }

    /* Recortar el 16:9 en un viewport vertical dejaría solo la niebla del
       centro, así que hay un encuadre 9:16 propio. La condición es la
       orientación, no el ancho: lo que rompe el encuadre es la proporción, así
       que esto cubre también tablet en vertical y móvil en horizontal. */
    @media (orientation: portrait) {
        .hero-photo-bg--light {
            background-image: url("/images/hero-skyline.jpg");
            background-image: image-set(url("/images/hero-skyline-mobile.webp") type("image/webp"),
                    url("/images/hero-skyline.jpg") type("image/jpeg"));
        }

        .hero-photo-bg--dark {
            background-image: url("/images/hero-skyline-dark.jpg");
            background-image: image-set(url("/images/hero-skyline-dark-mobile.webp") type("image/webp"),
                    url("/images/hero-skyline-dark.jpg") type("image/jpeg"));
        }
    }

    /* Las animaciones de red compiten con la foto: quedan como acento. En light
       estorban directamente, igual que el resto de overlays decorativos. */
    .hero-net-canvas {
        opacity: 0.18;
    }

    [data-theme="light"] .hero-net-canvas {
        display: none;
    }

    /* Aclara la zona del texto para que H1, párrafo y CTAs mantengan contraste
       sobre el vidrio, y funde el borde inferior con la sección siguiente. */
    .hero-scrim {
        --scrim-y: 46%;
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background:
            radial-gradient(ellipse 58% 48% at 50% var(--scrim-y),
                rgba(233, 233, 236, 0.94) 0%,
                rgba(233, 233, 236, 0.80) 45%,
                rgba(233, 233, 236, 0.38) 72%,
                rgba(233, 233, 236, 0.08) 100%),
            linear-gradient(to bottom,
                rgba(233, 233, 236, 0.60) 0%,
                rgba(233, 233, 236, 0.00) 16%,
                rgba(233, 233, 236, 0.00) 58%,
                rgba(233, 233, 236, 0.55) 82%,
                rgba(233, 233, 236, 0.94) 94%,
                var(--color-bg) 100%);
    }

    /* Heroes cuyo contenido arranca arriba (justify-start + pt-*). */
    .hero-scrim--top {
        --scrim-y: 30%;
    }

    /* La foto nocturna ya trae su propio contraste, así que aquí el scrim
       invierte su papel: en vez de aclarar el centro, apaga las esquinas para
       que las luces cálidas de las ventanas no compitan con el dorado del H1
       ni con el CTA. */
    [data-theme="dark"] .hero-scrim {
        background:
            radial-gradient(ellipse 62% 52% at 50% var(--scrim-y),
                rgba(3, 3, 3, 0.28) 0%,
                rgba(3, 3, 3, 0.48) 55%,
                rgba(3, 3, 3, 0.80) 100%),
            linear-gradient(to bottom,
                rgba(3, 3, 3, 0.65) 0%,
                rgba(3, 3, 3, 0.00) 20%,
                rgba(3, 3, 3, 0.00) 58%,
                rgba(3, 3, 3, 0.60) 82%,
                rgba(3, 3, 3, 0.94) 94%,
                var(--color-bg) 100%);
    }

    /* En vertical los edificios ocupan el ancho completo justo donde va el
       texto, así que el scrim se ensancha (88%) y se estrecha en alto (34%):
       abre una banda limpia para el contenido y deja la arquitectura legible
       arriba y abajo. El lavado del 0% protege el logo del nav.
       Debe ir después de las reglas de dark para poder sobreescribirlas. */
    @media (orientation: portrait) {
        .hero-scrim {
            background:
                radial-gradient(ellipse 88% 34% at 50% var(--scrim-y),
                    rgba(233, 233, 236, 0.95) 0%,
                    rgba(233, 233, 236, 0.85) 45%,
                    rgba(233, 233, 236, 0.55) 75%,
                    rgba(233, 233, 236, 0.12) 100%),
                linear-gradient(to bottom,
                    rgba(233, 233, 236, 0.72) 0%,
                    rgba(233, 233, 236, 0.10) 14%,
                    rgba(233, 233, 236, 0.00) 26%,
                    rgba(233, 233, 236, 0.00) 62%,
                    rgba(233, 233, 236, 0.55) 84%,
                    rgba(233, 233, 236, 0.95) 94%,
                    var(--color-bg) 100%);
        }

        [data-theme="dark"] .hero-scrim {
            background:
                radial-gradient(ellipse 88% 34% at 50% var(--scrim-y),
                    rgba(3, 3, 3, 0.60) 0%,
                    rgba(3, 3, 3, 0.52) 45%,
                    rgba(3, 3, 3, 0.40) 75%,
                    rgba(3, 3, 3, 0.22) 100%),
                linear-gradient(to bottom,
                    rgba(3, 3, 3, 0.72) 0%,
                    rgba(3, 3, 3, 0.15) 14%,
                    rgba(3, 3, 3, 0.00) 26%,
                    rgba(3, 3, 3, 0.00) 62%,
                    rgba(3, 3, 3, 0.60) 84%,
                    rgba(3, 3, 3, 0.95) 94%,
                    var(--color-bg) 100%);
        }
    }
</style>
